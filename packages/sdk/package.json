{
  "name": "shipstat",
  "version": "0.1.0",
  "description": "Open source analytics & A/B testing for React Native and Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "lint": "eslint src/",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "keywords": [
    "react-native",
    "expo",
    "analytics",
    "ab-testing",
    "a/b testing",
    "open-source",
    "mobile-analytics",
    "events",
    "vexo-alternative",
    "shipstat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MatthysDev/shipstat.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/MatthysDev/shipstat/issues"
  },
  "author": "MatthysDev (https://github.com/MatthysDev)",
  "license": "MIT",
  "homepage": "https://github.com/MatthysDev/shipstat#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android/build.gradle",
    "android/src",
    "expo-module.config.json",
    "!**/__tests__"
  ],
  "sideEffects": false
}
